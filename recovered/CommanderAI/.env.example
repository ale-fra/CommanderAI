# Anthropic API key — required only for AI features (build without --no-llm, suggest, explain)
ANTHROPIC_API_KEY=sk-ant-...

# Optional path overrides (defaults shown). Relative paths resolve from your shell's cwd.
# COMMANDERAI_COLLECTION=data/my_collection.txt
# COMMANDERAI_DECKS_DIR=decks
# COMMANDERAI_DB=data/commanderai.db
# COMMANDERAI_CACHE=~/.commanderai

# Never call external services (Commander Spellbook, Claude, Scryfall). Power
# brackets then use offline rules (game changers, extra turns, land denial).
# COMMANDERAI_OFFLINE=1
