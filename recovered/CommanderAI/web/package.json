{
  "name": "commanderai-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "gen:api": "../.venv/bin/python -m commanderai.api.openapi > openapi.json && openapi-typescript openapi.json -o src/api/schema.gen.ts",
    "check:api": "openapi-typescript openapi.json -o .schema.check.ts >/dev/null && diff -q .schema.check.ts src/api/schema.gen.ts && rm .schema.check.ts",
    "check:bundle": "node tools/check-bundle.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "react-router": "7.18.4",
    "@tanstack/react-query": "5.104.5",
    "@tabler/icons-react": "3.49.0",
    "mana-font": "1.18.0",
    "@fontsource-variable/inter": "5.3.0",
    "openapi-fetch": "0.17.0",
    "@mantine/charts": "9.7.3",
    "@mantine/notifications": "9.7.3",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@biomejs/biome": "2.6.2",
    "vitest": "5.0.5",
    "jsdom": "29.1.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/user-event": "14.6.8",
    "@playwright/test": "1.56.1",
    "postcss": "8.5.31",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "@types/node": "22",
    "openapi-typescript": "7.13.0",
    "@axe-core/playwright": "4.14.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "playwright": "1.56.1",
    "playwright-core": "1.56.1"
  }
}
